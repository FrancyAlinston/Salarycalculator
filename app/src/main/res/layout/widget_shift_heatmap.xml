<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_bg"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- Clean Header: Month Title, Interactive Today Shift Pill & Gross Summary -->
    <LinearLayout
        android:id="@+id/widget_title_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/widget_month_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="September 2026"
            android:textColor="#FFFFFFFF"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <!-- FEAT-930: Interactive Quick Shift Pill (1-tap to cycle today's shift) -->
        <TextView
            android:id="@+id/widget_btn_quick_log_today"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_pill_off_bg"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="7dp"
            android:paddingTop="2.5dp"
            android:paddingEnd="7dp"
            android:paddingBottom="2.5dp"
            android:text="Today: Off"
            android:textColor="#FFFFFFFF"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_summary_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="16 Shifts • £2,461.44"
            android:textColor="#34D399"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Full-Size Shift Heatmap Canvas -->
    <ImageView
        android:id="@+id/widget_heatmap_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="Shift Heatmap Grid"
        android:scaleType="fitCenter" />

</LinearLayout>
