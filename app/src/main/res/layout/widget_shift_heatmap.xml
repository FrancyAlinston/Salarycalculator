<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Header Navigation & Info Bar -->
    <LinearLayout
        android:id="@+id/widget_header_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/widget_title_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_month_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="September 2026"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_summary_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="16 Shifts • £2,461.44 Gross"
                android:textColor="#B3FFFFFF"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- Navigation & Mode Buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/widget_btn_prev"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/widget_btn_bg"
                android:contentDescription="Previous Month"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_prev" />

            <ImageButton
                android:id="@+id/widget_btn_today"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/widget_btn_bg"
                android:contentDescription="Current Month"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_today" />

            <ImageButton
                android:id="@+id/widget_btn_next"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/widget_btn_bg"
                android:contentDescription="Next Month"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_next" />

            <ImageButton
                android:id="@+id/widget_btn_transparency"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/widget_btn_bg"
                android:contentDescription="Toggle Transparent Mode"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_opacity" />
        </LinearLayout>
    </LinearLayout>

    <!-- Calendar Heatmap Dynamic Canvas -->
    <ImageView
        android:id="@+id/widget_heatmap_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="Shift Heatmap Grid"
        android:scaleType="fitCenter" />

</LinearLayout>
